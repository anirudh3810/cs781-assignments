freq < other.freq\n\ndef build_huffman_tree(frequencies):\n    \"\"\"\n    Builds a Huffman tree from the given word frequencies.\n    Prints the number of leaf nodes, internal nodes, and total nodes.\n    \n    Returns:\n        paths: dict mapping word_idx -> list of internal node indices\n        codes: dict mapping word_idx -> list of binary decisions (+1/-1)\n        internal_idx: Total number of internal nodes created\n    \"\"\"\n    # 1. Initialize Min-Heap with leaf nodes\n    heap = []\n    for word_idx, freq in frequencies.items():\n        heapq.heappush(heap, HuffmanNode(freq, word_idx))\n        \n    leaf_nodes = len(frequencies)\n    internal_nodes = 0\n    \n    # 2. Build the Tree\n    while len(heap) > 1:\n        left = heapq.heappop(heap)\n        right = heapq.heappop(heap)\n        \n        parent = HuffmanNode(left.freq + right.freq)\n        parent.left = left\n        parent.right = right\n        parent.internal_idx = internal_nodes\n        internal_nodes += 1\n        \n        heapq.heappush(heap, parent)\n        \n    total_nodes = leaf_nodes + internal_nodes\n    \n    # Print counts as instructed\n    print(f\"Huffman Tree -> Leaf nodes: {leaf_nodes}, Internal nodes: {internal_nodes}, Total nodes: {total_nodes}\")\n    \n    root = heap[0]\n    paths = {}\n    codes = {}\n    \n    # 3. Traverse the tree to extract paths and codes\n    def traverse(node, current_path, current_code):\n        if node is None:\n            return\n        \n        # If it's a leaf node, save the path and code\n        if node.word_idx is not None:\n            paths[node.word_idx] = list(current_path)\n            codes[node.word_idx] = list(current_code)\n            return\n        \n        # Internal node traversal\n        current_path.append(node.internal_idx)\n        \n        # Left child = +1\n        current_code.append(1)\n        traverse(node.left, current_path, current_code)\n        current_code.pop()\n        \n        # Right child