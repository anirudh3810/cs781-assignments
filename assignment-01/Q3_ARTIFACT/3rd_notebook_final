"class CBOWHierarchicalSoftmax(CBOWBase):\n    def __init__(self, vocab_size, num_internal_nodes, embed_dim):\n        super().__init__(vocab_size, embed_dim)\n        \n        # Initialize internal node embeddings. \n        # Size is (num_internal_nodes + 1) because pad_paths_codes padded the arrays \n        # with the value `num_internal_nodes`. We use this as our padding index.\n        self.internal_embeddings = nn.Embedding(\n            num_internal_nodes + 1, \n            embed_dim, \n            padding_idx=num_internal_nodes\n        )\n        \n        # Initialize output representations (internal nodes) to zero, as is standard in Word2Vec.\n        nn.init.zeros_(self.internal_embeddings.weight)\n\n    def forward(self, contexts, paths, codes, masks):\n        \"\"\"\n        Args:\n            contexts: (B, 2*window_size)\n            paths: (B, max_len) - indices of internal nodes\n            codes: (B, max_len) - (+1 or -1) binary decisions\n            masks: (B, max_len) - 1.0 for valid path steps, 0.0 for padding\n        \"\"\"\n        # 1. Get average context vector 'h'\n        # Shape: (B, embed_dim)\n        h = self.pool_context(contexts)\n        \n        # Reshape 'h' into a column vector for batched matrix multiplication\n        # Shape: (B, embed_dim, 1)\n        h_col = h.unsqueeze(2)\n\n        # 2. Get embeddings for the internal nodes along the path\n        # Shape: (B, max_len, embed_dim)\n        v_n = self.internal_embeddings(paths)\n\n        # 3. Compute batched dot products (scores for each node in the path)\n        # (B, max_len, embed_dim) bmm (B, embed_dim, 1) -> (B, max_len, 1) -> squeeze to (B, max_len)\n        scores = torch.bmm(v_n, h_col).squeeze(2)\n\n        # 4. Multiply scores by the true decisions (+1 for left, -1 for right)\n        # We cast codes to float since they will be multiplied by float scores.\n        codes = codes.float()\n        \n        # 5. Compute Vectorized Loss using Numerically Stable Log-Sigmoid\n        # For Hierarchical Softmax, the objective is to maximize log(sigmoid(code * score)).\n        # Loss = -sum(logsigmoid(code * score) * mask)\n        log_probs = F.logsigmoid(codes * scores)\n        \n        # 6. Apply masks so padding tokens (0.0) don't contribute to the loss sum\n        masked_log_probs = log_probs * masks\n        \n        # Sum the log probabilities along the length of the path (dim=1) and take the negative\n        path_loss = -masked_log_probs.sum(dim=1)\n\n        # Return the mean loss for the batch\n        return path_loss.mean()","metadata":{"id":"CeMBRBXUoNJC","trusted":true,"execution":{"iopub.status.busy":"2026-08-26T22:49:39.843801Z","iopub.execute_input":"2026-08-26T22:49:39.844120Z","iopub.status.idle":"2026-08-26T22:49:39.857984Z","shell.execute_reply.started":"2026-08-26T22:49:39.844088Z","shell.execute_reply":"2026-08-26T22:49:39.857306Z"}},"outputs":[],"execution_count":19},{"cell_type":"code","source":"def train_word2vec_hs(encoded_corpus, stoi, freq, epochs=EPOCHS, embed_dim=EMBED_DIM,\n                       window=WINDOW_SIZE, batch_size=BATCH_SIZE, lr=LR_HS, label=\"\"):\n    set_shared_seed()\n    vocab_size = len(stoi)\n\n    paths, codes, num_internal_nodes = build_huffman_tree(freq)\n    padded_paths, padded_codes, masks = pad_paths_codes(paths, codes, vocab_size, num_internal_nodes)\n    paths_tensor = torch.tensor(padded_paths, dtype=torch.long, device=DEVICE)\n    codes_tensor = torch.tensor(padded_codes, dtype=torch.long, device=DEVICE)\n    masks_tensor = torch.tensor(masks, dtype=torch.float32, device=DEVICE)\n\n    dataset = CBOWDataset(encoded_corpus, window, vocab_size)\n    loader = DataLoader(dataset, batch_size=batch_size, shuffle=True, generator=shared_generator())\n\n    model = CBOWHierarchicalSoftmax(vocab_size, num_internal_nodes, embed_dim).to(DEVICE)\n    optimizer = optim.Adam(model.parameters(), lr=lr)\n    scaler = torch.amp.GradScaler(device=DEVICE.type)\n\n    start_epo