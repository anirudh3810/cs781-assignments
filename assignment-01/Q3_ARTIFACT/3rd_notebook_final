           print(f\"[checkpoint] final checkpoint download failed ({e}); grab {path} manually.\")\n\n\ndef load_checkpoint_if_present(label, model, optimizer, scaler, vocab_size, embed_dim):\n    path = checkpoint_path(label)\n    if not os.path.exists(path):\n        print(f\"[checkpoint] none found for {label}, starting from epoch 0.\")\n        return 0, [], 0.0\n\n    ckpt = torch.load(path, map_location=DEVICE)\n\n    if ckpt.get(\"vocab_size\") != vocab_size or ckpt.get(\"embed_dim\") != embed_dim:\n        raise ValueError(\n            f\"[checkpoint] MISMATCH for {label}: checkpoint has \"\n            f\"vocab_size={ckpt.get('vocab_size')}, embed_dim={ckpt.get('embed_dim')}, \"\n            f\"but this run has vocab_size={vocab_size}, embed_dim={embed_dim}. \"\n            \"This is the wrong checkpoint for this run — delete it, don't resume with it.\"\n        )\n\n    model.load_state_dict(ckpt[\"model_state_dict\"])\n    optimizer.load_state_dict(ckpt[\"optimizer_state_dict\"])\n    scaler.load_state_dict(ckpt[\"scaler_state_dict\"])\n    start_epoch = ckpt[\"epoch\"]\n    epoch_losses = ckpt[\"epoch_losses\"]\n    elapsed_time = ckpt.get(\"elapsed_time\", 0.0)\n    print(f\"[checkpoint] resumed {label} from epoch {start_epoch} \"\n          f\"({elapsed_time/60:.1f} min already logged).\")\n    return start_epoch, epoch_losses, elapsed_time\n\n\ndef upload_checkpoint(label):\n    \"\"\"Run this only when resuming after a crash/disconnect.\"\"\"\n    try:\n        from google.colab import files\n    except ImportError as exc:\n        raise RuntimeError(\"Checkpoint upload helper is intended for Google Colab.\") from exc\n\n    uploaded = files.upload()\n    expected = checkpoint_path(label)\n    for fname in uploaded:\n        if fname != expected:\n            os.rename(fname, expected)\n    print(f\"[checkpoint] restored {expected} into the runtime.\")\n\n\ndef save_pkl(filename, embeddings, vocab, stoi, epoch_losses=None, total_time=None,\n         